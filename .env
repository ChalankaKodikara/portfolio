# ================================================
# 🌐 SERVER CONFIGURATION
# ================================================

# Port for your Express app
PORT=5173

# Base URL of your API (helpful if frontend needs it)
API_BASE_URL=http://localhost:5173

# Directory settings (optional overrides)
DATA_DIR=./data
UPLOADS_DIR=./public/uploads

# ================================================
# ⚙️ MULTER / UPLOAD CONFIG
# ================================================

# Maximum upload file count (for safety)
MAX_UPLOAD_COUNT=20

# Allowed file types (optional, if you want to validate)
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.svg,.pdf

# ================================================
# 🧠 APP SETTINGS
# ================================================

# Default hero intro text
HERO_DEFAULT_TEXT=Hello, I’m Chalanka Kodikara

VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=1234
